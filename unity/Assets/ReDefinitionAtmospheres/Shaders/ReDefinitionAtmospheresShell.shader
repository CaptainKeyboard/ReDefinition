// The cover shell of a part (src/Atmospheres/Cover/VehicleCover.cs): a second mesh over the part, inflated by a centimetre or two, that
// shows cover on the faces that look up. The mask is on the GPU: smoothstep(_EdgeLow, _EdgeHigh, dot(worldNormal, _UpWorld)), so a
// vessel that rolls keeps cover on the faces that are up now. The amount (0 to 1, per vessel, by a property block) is how much of the
// up-facing area is covered: a stable per-position hash decides which part of it, so that the cover grows from nothing in specks and
// does not fade as a layer (the fade of a layer would need a transparent queue; this stays opaque, queue 2001, so that the depth and
// motion-vector passes of the upscalers draw it with the part: VesselMotionVectors draws every opaque mesh renderer under a part).
//
// Depth: ZWrite on, Offset -1,-1 (the shell lies within centimetres of the part). No shadow caster (no addshadow, Fallback Off): the
// part's own casts; the shell receives shadows through the surface shader. Lighting: Lambert, forward and deferred paths are
// generated by the surface shader. There is no hand-written MotionVectors pass: the renderer sets motionVectorGenerationMode = Object
// and the engine's default draws the shell's motion. [VERIFY in the player: motion-vector match on a moving stand-in.]
Shader "ReDefinition/AtmospheresShell"
{
    Properties
    {
        _CoverColor ("Cover colour", Color) = (0.93, 0.95, 0.98, 1)
        _Amount ("Amount", Range(0, 1)) = 0
        _UpWorld ("Up (world)", Vector) = (0, 1, 0, 0)
        _EdgeLow ("Mask low", Range(0, 1)) = 0.35
        _EdgeHigh ("Mask high", Range(0, 1)) = 0.75
        _Grain ("Grain scale", Float) = 40
    }
    SubShader
    {
        Tags { "RenderType" = "Opaque" "Queue" = "Geometry+1" "IgnoreProjector" = "True" }
        LOD 200
        Offset -1, -1

        CGPROGRAM
        #pragma surface surf Lambert vertex:vert exclude_path:prepass noforwardadd nolightmap nometa
        #pragma target 3.0

        fixed4 _CoverColor;
        float _Amount;
        float4 _UpWorld;
        float _EdgeLow;
        float _EdgeHigh;
        float _Grain;

        struct Input
        {
            float3 shellObjectPos;
            float shellMask;
        };

        void vert(inout appdata_full v, out Input o)
        {
            UNITY_INITIALIZE_OUTPUT(Input, o);
            float3 worldNormal = UnityObjectToWorldNormal(v.normal);
            o.shellMask = smoothstep(_EdgeLow, _EdgeHigh, dot(worldNormal, normalize(_UpWorld.xyz)));
            o.shellObjectPos = v.vertex.xyz;
        }

        // A stable value from 0 to 1 per position in the part's own frame: the specks stay on the part while it moves.
        float Grain(float3 p)
        {
            p = floor(p * _Grain);
            return frac(sin(dot(p, float3(12.9898, 78.233, 37.719))) * 43758.5453);
        }

        void surf(Input IN, inout SurfaceOutput o)
        {
            // Visible where the up-facing share is larger than the grain: the share is amount x mask.
            clip(_Amount * IN.shellMask - Grain(IN.shellObjectPos) * 0.999 - 0.001);
            o.Albedo = _CoverColor.rgb;
            o.Alpha = 1;
        }
        ENDCG
    }
    Fallback Off
}
