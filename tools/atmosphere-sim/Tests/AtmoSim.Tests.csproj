<Project Sdk="Microsoft.NET.Sdk">

  <!-- Run with: dotnet test tools/atmosphere-sim/Tests (not part of the solution). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>AtmoSim.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AtmoSim.Core\AtmoSim.Core.csproj" />
    <ProjectReference Include="..\AtmoSim.Runner\AtmoSim.Runner.csproj" />
  </ItemGroup>

</Project>
