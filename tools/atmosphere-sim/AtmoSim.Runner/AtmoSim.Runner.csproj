<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AtmoSim.Runner</RootNamespace>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Steady-state code from the first call (Mono compiles once, without tiers); the cost loop of criterion 6 must not measure tier-0 code. -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AtmoSim.Core\AtmoSim.Core.csproj" />
  </ItemGroup>

</Project>
