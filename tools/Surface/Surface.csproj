<Project Sdk="Microsoft.NET.Sdk">
  <!-- The surface snapshot (tools/Surface/SurfaceBuilder.cs): what a player or another mod can see of a ReDefinition build, as
       lines of text. net48 so that it can load a build's ReDefinition.dll and read the defaults of its settings. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Surface</AssemblyName>
    <RootNamespace>Surface</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
