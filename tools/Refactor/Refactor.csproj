<Project Sdk="Microsoft.NET.Sdk">

  <!-- Restructures the repository from a manifest: moves files with git, puts the types of moved
       files into their new namespaces, adds the usings that move makes necessary, renames identifiers
       and rewrites the paths that name moved files (tools/Refactor/Program.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Refactor</RootNamespace>
    <AssemblyName>Refactor</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

</Project>
