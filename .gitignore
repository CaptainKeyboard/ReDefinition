build/
bin/
obj/
.idea/
.vs/
*.user
*.suo

# Unity project: only Assets, Packages and ProjectSettings are tracked.
unity/Library/
unity/Temp/
unity/Logs/
unity/UserSettings/
unity/obj/
unity/*.csproj
unity/*.sln

# The raytracing test player (tools/build_rt_player.py): Unity's work and the files it
# copies in from src/ and unity/.
tests/RaytracingPlayer/Library/
tests/RaytracingPlayer/Temp/
tests/RaytracingPlayer/Logs/
tests/RaytracingPlayer/UserSettings/
tests/RaytracingPlayer/obj/
tests/RaytracingPlayer/*.csproj
tests/RaytracingPlayer/*.sln
tests/RaytracingPlayer/Assets/Linked/
tests/RaytracingPlayer/Assets/Linked.meta
tests/RaytracingPlayer/Assets/Scenes/
tests/RaytracingPlayer/Assets/Scenes.meta

# The weather test player (tools/build_weather_player.py), same rules.
tests/WeatherPlayer/Library/
tests/WeatherPlayer/Temp/
tests/WeatherPlayer/Logs/
tests/WeatherPlayer/UserSettings/
tests/WeatherPlayer/obj/
tests/WeatherPlayer/*.csproj
tests/WeatherPlayer/*.sln
tests/WeatherPlayer/Assets/Linked/
tests/WeatherPlayer/Assets/Linked.meta
tests/WeatherPlayer/Assets/Scenes/
tests/WeatherPlayer/Assets/Scenes.meta

# AMD's runtime for the player package, fetched by tools/fetch_amd_runtime.py
# (third_party/amd/README.md).
third_party/amd/*.dll
third_party/amd/*.part

# Python's bytecode caches from the tools.
__pycache__/

# Claude Code: local settings and worktrees.
.claude/

# The iCUE widget packager (tools/icuewidget): npm install puts its modules here.
node_modules/
