<?xml version="1.0" encoding="utf-8"?>
<!-- Die globale NuGet.Config dieser Maschine hat keine Paketquellen. Damit der
     Build ueberall gleich laeuft, bringt das Repo seine eigene mit. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
