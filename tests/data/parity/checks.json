{
  "$comment": "The per-feature check list of the parity harness (package T11). One entry per metric of the parity table (tvc-parity.md 4.3). function = the function in tools/weather_metrics/parity_checks.py; reference = analytic | renderer (parity_ref.py on the same density field) | band (published or measured range) | gate (a threshold taken from a finished gate or measured TVC value); capture = reference (parity_run.py reference renders it), player (a Parity scene of the weather player) or game (a K series); package = the package that fills the column 'ours'. Every threshold is FIXED (none is open any more); its source is thresholdSource. tvc names the view of tests/data/parity/tvc-capture.md that fills the TVC column, or none.",
  "version": 1,
  "harness": "T11",
  "numbers": [
    { "id": "N01", "name": "Sun angular diameter", "value": 9.3, "unit": "mrad", "kind": "published", "source": "mean angular diameter of the solar disc 0.5334 deg = 9.31 mrad (astronomy reference values, e.g. Allen's Astrophysical Quantities)" },
    { "id": "N02", "name": "Beer-Lambert slab", "value": 0.02, "unit": "relative", "kind": "analytic", "source": "T = exp(-tau): T(2h) = T(h)^2; self-test of the reference 1 %, pass 2 %" },
    { "id": "N03", "name": "HG normalisation", "value": 0.01, "unit": "relative", "kind": "analytic", "source": "integral over the sphere of the Henyey-Greenstein function = 1 (Henyey and Greenstein 1941)" },
    { "id": "N04", "name": "Horizon row error", "value": 2.0, "unit": "px", "kind": "analytic", "source": "dip angle acos(R / (R + h)), distance sqrt(2 R h + h^2); the reference's own quantisation is 0.5 px, the pass may add one march step" },
    { "id": "N05", "name": "Repetition autocorrelation at the tile distance", "value": 0.15, "unit": "correlation", "kind": "measured", "source": "reference noise, 8 seeds, 40 x 20 km stripe at the 20 km lag: -0.070 <= r <= 0.028; a repeating tile gives 0.79 to 0.83 (parity_run.py numbers); the proposed 0.15 stays" },
    { "id": "N06", "name": "Noise spectrum slope band", "value": [1.3, 2.6], "unit": "power-law exponent", "kind": "published", "source": "cloud liquid-water-path and radiance spectra scale with exponent 5/3 (Davis et al. 1996, J. Atmos. Sci. 53; Cahalan and Snider 1989) and the cloud perimeter dimension 1.35 (Lovejoy 1982, Science 216) gives 2.3 for a profile; widened by 0.3 for the spread of the slope estimate over seeds (reference run: 1.39 to 2.40 over three seeds and three octave bands) [VERIFY: citations quoted from memory, sources not opened]" },
    { "id": "N07", "name": "Silver lining ratio", "value": 2.0, "unit": "ratio", "kind": "measured", "source": "plan floor 2.0; the reference run measures 18.0 (edge source function with the sun 8 deg from the view axis over 75 deg, sun elevation 8 deg; the analytic phase ratio of the reference phase is 145)" },
    { "id": "N08", "name": "Light-step error", "value": 0.10, "unit": "relative", "kind": "measured", "source": "plan 10 %; the reference run: 1 step 45 %, 2 steps 3.8 %, 4 steps 0.9 %, 8 steps 0.2 % against 64 steps; 64 against 256 steps 0.003 %" },
    { "id": "N09", "name": "Cumulus top / base luminance ratio", "value": 1.84, "unit": "ratio", "kind": "measured", "source": "reference renderer, cell of 800 m radius, sun 50 deg elevation from the side, multiple scattering order 64 (parity_run.py numbers); single scattering alone gives 7.3. Pass: within 20 % of the reference ratio, top not darker than base, base not black. The plan's photographic band 2 to 6 has no citation and is not used [VERIFY]" },
    { "id": "N10", "name": "Powder dip", "value": 0.79, "unit": "ratio", "kind": "measured", "source": "reference renderer: edge over interior source function 0.79 with multiple scattering (a dip) and 1.78 with single scattering only (parity_run.py numbers); pass: same side of 1 as the reference and within 25 % of it" },
    { "id": "N11", "name": "Penumbra width", "value": "h * 9.3 mrad / sin^2(e) + 2 px, within 25 %", "unit": "m", "kind": "analytic", "source": "shadow geometry of a sun disc of 9.3 mrad at elevation e on flat ground; the plan's h * 0.0093 is the overhead case" },
    { "id": "N12", "name": "Lightning delay", "value": 343.2, "unit": "m/s", "kind": "published", "source": "speed of sound in air at 20 C (standard value 343.2 m/s)" },
    { "id": "N13", "name": "Aerial perspective", "value": 3.912, "unit": "-", "kind": "analytic", "source": "Koschmieder relation: beta = 3.912 / V for the 2 % contrast threshold (Koschmieder 1924); L = L0 T + Lsky (1 - T)" },
    { "id": "N14", "name": "ghost_move / trail_px", "value": [0.012, 0.14], "unit": "-", "kind": "gate", "source": "tests/series/rows/C21.json (C21 gates)" },
    { "id": "N15", "name": "mv_match", "value": 0.98, "unit": "-", "kind": "gate", "source": "tests/series/rows/C21.json" },
    { "id": "N16", "name": "Cost", "value": "TVC ms + 10 %", "unit": "ms", "kind": "gate", "source": "tvc-parity Q11: TVC's measured ms at the reference views (A4500 Medium, T09's series)" }
  ],
