    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.humilis_share", "min": 0, "max": 1, "unit": "share", "required": false, "note": "INFORMATION." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.humilis_row_span", "min": 0, "max": 1, "unit": "share", "required": false, "note": "INFORMATION." },

