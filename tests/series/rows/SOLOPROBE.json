{
  "$schema": "../schema.json",
  "package": "SOLOPROBE",
  "rows": [
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.layers", "min": 1, "unit": "layers", "required": false, "note": "INFORMATION: the layers of the own pass's stack at the pad (Kerbin: 4)." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.window_opens_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: Toggle opens the viewer's window and session within 10 s. Fails: nothing else is checked." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.sun_found_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: with the vessel placed and held first, one of 37 time offsets (600 s apart, 10 degrees of the sun's hour angle) puts the sun at 45 degrees elevation within 5 degrees and going down (afternoon: the sun is behind a camera looking east), as the game's own sun reads. Fails: no offset does." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.sun_elevation_deg", "min": 40, "max": 50, "unit": "deg", "required": false, "note": "EXPECTED: the sun's elevation every picture is taken at (time frozen)." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.solo_types", "min": 10, "unit": "types", "required": false, "note": "INFORMATION: the types of the stack the solo control offers (Kerbin: 3 + 5 + 3 + 2 = 13)." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.fov_deg", "min": 10, "max": 120, "unit": "deg", "required": false, "note": "INFORMATION: the camera's vertical field of view the frame shares are stated for (60 degrees)." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.noise_floor_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: two pictures of the same empty frame (the first view's baseline taken twice) differ in at most 1 percent of the frame: the floor every share is measured above. Fails: every share is contaminated." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.noise_floor_share", "max": 0.01, "unit": "share", "required": false, "note": "INFORMATION: the share of the frame the two baselines differ in." },

    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.cb_near_type_found_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the type Cumulonimbus incus is in the stack (role cumulonimbus). Fails: the view does not run." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.cb_near_pose_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: read from the game: the camera's elevation is within 3 degrees of the view's (15) and the camera is at least 5 m above the ground. The share bands and the horizon row are stated for this pose." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.cb_near_background_clear_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: in the baseline frame every layer's forced map reads 0 in the pass's reader, every layer's cover at the vessel is at most 0.02 and no rain is forced (forceLevel 0)." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.cb_near_isolated_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the layer mask the pass gave its shader is the cumulonimbus layer's bit, its forced map is 1, every other layer reads 0 (map and cover at the vessel), the solo selection reads back as that layer, that type, a cell, and no rain is forced." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.cb_near_picture_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the solo picture is written and both pictures can be read (same size)." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.cb_near_share_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the cell 25 km ahead (tower and the anvil it spreads overhead) fills 0.40 to 0.90 of the sky above the horizon (the ground rows and the vessel's box left out; the tower alone fills about 0.2). Fails: the cell is not in view, has no anvil, or fills the frame." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.cb_near_span_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the cloud reaches 0.40 to 1.0 of the frame's height (from the horizon up) (the tower's 3 degrees at its base up through the anvil to the top of the frame). A tower without its anvil reaches about 0.35 and fails." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.cb_near_share", "min": 0, "max": 1, "unit": "share", "required": false, "note": "INFORMATION: the share of the frame the cloud fills." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.cb_near_row_span", "min": 0, "max": 1, "unit": "share", "required": false, "note": "INFORMATION: the share of the frame's height the cloud reaches." },

    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.cb_far_type_found_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the type Cumulonimbus incus is in the stack." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.cb_far_pose_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: as cb_near (elevation 5)." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.cb_far_background_clear_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: as cb_near." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.cb_far_isolated_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: as cb_near." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.cb_far_picture_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: as cb_near." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.cb_far_share_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the cell 60 km ahead (the whole cell on the horizon, the anvil above and toward the camera) fills 0.04 to 0.60 of the frame." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.cb_far_span_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the cloud reaches 0.20 to 0.80 of the frame's height." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.cb_far_share", "min": 0, "max": 1, "unit": "share", "required": false, "note": "INFORMATION." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.cb_far_row_span", "min": 0, "max": 1, "unit": "share", "required": false, "note": "INFORMATION." },

    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.sc_type_found_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the type Stratocumulus is in the cumulus layer." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.sc_pose_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: as cb_near (elevation 45)." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.sc_background_clear_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: as cb_near." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.sc_isolated_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the pass's layer mask is the cumulus layer's bit, its forced map 0.8, every other layer 0, a uniform field, no forced rain." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.sc_picture_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: as cb_near." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.sc_share_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: forced at cover 0.8 and seen at 45 degrees elevation (the frame spans 15 to 75 degrees: all sky), the layer fills 0.35 to 1.0 of the frame." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.sc_share", "min": 0, "max": 1, "unit": "share", "required": false, "note": "INFORMATION." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.sc_row_span", "min": 0, "max": 1, "unit": "share", "required": false, "note": "INFORMATION." },

    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.humilis_type_found_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the type Cumulus humilis is in the cumulus layer." },
    { "series": "K-S1", "section": "SOLOPROBE", "start": "solo", "metric": "SOLO.humilis_pose_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: as cb_near (elevation 35)." },
