{
  "$schema": "../schema.json",
  "package": "SURFACE",
  "rows": [
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.window_opens_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: Toggle opens the viewer's window and session within 10 s." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.sun_found_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: K-S1's universal time (1470283.6) puts the sun within 6 degrees of 45, else one of 37 offsets does (K-S1's search)." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.type_found_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the type Cumulonimbus incus is in the stack." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p1_empty_frame_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: pose 1 (heading 90, K-S1's): with the cell at strength 0 the solo layer's forced map reads 0 and the pass's layer mask is the layer's bit." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p1_drawn_alone_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: with strength 1 the forced map reads 1 and the pass's layer mask is the layer's bit." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p1_same_aim_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the camera's azimuth and elevation after the seven frames are within 0.5 degrees of the pose's first frame." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p1_sun_fixed_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the sun's elevation after the frames is within 1 degree of the one it was set to." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p2_empty_frame_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: as p1 for pose 2 (heading 270)." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p2_drawn_alone_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: as p1." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p2_same_aim_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: as p1 over the three frames." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p2_sun_fixed_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: as p1." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.fog_rule_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the weather view asks for no fog in every baseline and drawn frame (a forced level owns the fog; forceLevel 0). Fails: the rule did not take effect." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.pictures_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: all ten pictures are written by the viewer's capture." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.poses_apart_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the angle between the camera and the sun differs by at least 60 degrees between pose 1 and pose 2 (read from the game's camera and sun). Fails: the headings do not give a view toward and a view away from the sun." },

    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.sun_elevation_deg", "min": 39, "max": 51, "unit": "deg", "required": false, "note": "INFORMATION: the sun's elevation of every frame." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.ut_s", "min": 0, "unit": "s", "required": false, "note": "INFORMATION: the universal time of the frames (K-S1's pictures: 1470283.6)." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.old_fog_asks_fog", "min": 0, "max": 1, "required": false, "note": "INFORMATION: 1 if the weather view asked for a fog under the old rule (the field rains at the vessel at this time). 0: old_fog and baseline are the same frame and the fog is not the white of the mountains." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p1_aim_elevation_deg", "min": 1, "max": 9, "unit": "deg", "required": false, "note": "INFORMATION: the camera's elevation at pose 1 (5 asked)." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p1_sun_angle_deg", "min": 0, "max": 180, "unit": "deg", "required": false, "note": "INFORMATION: the angle between the camera's forward and the sun at pose 1 (K-S1's log line says 0 for this heading)." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p2_aim_elevation_deg", "min": 1, "max": 9, "unit": "deg", "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p2_sun_angle_deg", "min": 0, "max": 180, "unit": "deg", "required": false, "note": "INFORMATION: the angle at pose 2 (heading 270): expected well above 90." },

    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p1_old_fog_fog_density", "min": 0, "unit": "1/m", "required": false, "note": "INFORMATION: the scene fog's density (RenderSettings.fogDensity, 0 where the fog is off) per frame; the name is pose_frame. A density of 1e-4 leaves 5 % of a terrain's own colour at 17 km." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p1_old_fog_fog_asked", "min": 0, "unit": "1/m", "required": false, "note": "INFORMATION: the density the weather view asks of the fog writer." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p1_old_fog_level", "min": 0, "max": 1, "required": false, "note": "INFORMATION: the weather view's precipitation level." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p1_baseline_fog_density", "min": 0, "unit": "1/m", "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p1_baseline_fog_asked", "min": 0, "unit": "1/m", "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p1_baseline_level", "min": 0, "max": 1, "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p1_drawn_fog_density", "min": 0, "unit": "1/m", "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p1_drawn_fog_asked", "min": 0, "unit": "1/m", "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p1_drawn_level", "min": 0, "max": 1, "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p1_no_weather_fog_density", "min": 0, "unit": "1/m", "required": false, "note": "INFORMATION: weatherEffects off: the writer lets go; the weather field, the pass and the weather effects go with it." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p1_no_weather_fog_asked", "min": 0, "unit": "1/m", "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p1_no_weather_level", "min": 0, "max": 1, "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p1_no_pass_fog_density", "min": 0, "unit": "1/m", "required": false, "note": "INFORMATION: ownClouds off: only the cloud pass is off." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p1_no_pass_fog_asked", "min": 0, "unit": "1/m", "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p1_no_pass_level", "min": 0, "max": 1, "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p1_no_cover_fog_density", "min": 0, "unit": "1/m", "required": false, "note": "INFORMATION: groundCover off: the terrain's snow and wet repaint off." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p1_no_cover_fog_asked", "min": 0, "unit": "1/m", "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p1_no_cover_level", "min": 0, "max": 1, "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p1_no_atmo_fog_density", "min": 0, "unit": "1/m", "required": false, "note": "INFORMATION: Atmospheres' master switch off (the main mod's own settings, Scatterer, TUFX and the game's air stay)." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p1_no_atmo_fog_asked", "min": 0, "unit": "1/m", "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p1_no_atmo_level", "min": 0, "max": 1, "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p2_baseline_fog_density", "min": 0, "unit": "1/m", "required": false, "note": "INFORMATION: pose 2 (looking away from the sun)." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p2_baseline_fog_asked", "min": 0, "unit": "1/m", "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p2_baseline_level", "min": 0, "max": 1, "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p2_drawn_fog_density", "min": 0, "unit": "1/m", "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p2_drawn_fog_asked", "min": 0, "unit": "1/m", "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p2_drawn_level", "min": 0, "max": 1, "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p2_no_atmo_fog_density", "min": 0, "unit": "1/m", "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p2_no_atmo_fog_asked", "min": 0, "unit": "1/m", "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.p2_no_atmo_level", "min": 0, "max": 1, "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEPROBE", "start": "surface", "metric": "SURF.elapsed_s", "min": 0, "max": 900, "unit": "s", "required": false, "note": "INFORMATION: the scenario's length." }
  ]
}
