    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.launch_pin_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: enabled=0 from the command line is in force (the package is off, so nothing of it is between the pictures)." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.window_opens_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the viewer's window and session open within 10 s after the camera-only picture." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.sun_found_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: K-S2's time puts the sun within 6 degrees of 45 (the viewer's clock, for picture A)." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.cover_state_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the cover's PQS mod is in no sphere and no quad has a record." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.B_screen_read_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: picture B (the camera put at the far_p2 pose, the vessel left on the pad, UT = K-S2's) was read from the screen at the end of a frame." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.B_camera_height_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the camera of B stands within 15 m of 291 m above the ground." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.B_ui_hidden_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the game's interface is away while B is read (the viewer's capture hides it too)." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.B_aim_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the camera of B looks at azimuth 270 and elevation 5 within 2 degrees." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.A_aim_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the camera of A looks at azimuth 270 and elevation 5 within 2 degrees." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.A_camera_height_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the camera of A (the viewer's placement: the vessel held 300 m over the pad) stands within 15 m of 291 m above the ground." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.A_viewer_picture_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the viewer's capture wrote its picture." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.A_screen_read_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the screen was read back in the frame of the viewer's capture." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.A_same_frame_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the frame number of the screen read equals the frame the viewer asked the game for its picture in." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.A_picture_sizes_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the viewer's picture file and the screen read have the same width and height." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.sun_elevation_deg", "min": 39, "max": 51, "unit": "deg", "required": false, "note": "INFORMATION: the sun's elevation set for picture A." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.ut_s", "min": 0, "unit": "s", "required": false, "note": "INFORMATION: the universal time of picture A." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.elapsed_s", "min": 0, "max": 900, "unit": "s", "required": false, "note": "INFORMATION: the scenario's length." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.B_sun_elevation_deg", "min": -90, "max": 90, "unit": "deg", "required": false, "note": "INFORMATION: the sun's elevation at picture B (the clock runs there: A's is frozen at the same UT)." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.B_ground_r", "min": 0, "max": 255, "required": false, "note": "INFORMATION: mean red of the lower-left ground region of B (x 0 to 27 %, y 1.4 to 18 % from the bottom). The pictures K-S2 takes read about 76/85/86 there, tools/ProbeLite 90/102/81." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.B_ground_g", "min": 0, "max": 255, "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.B_ground_b", "min": 0, "max": 255, "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.A_viewer_ground_r", "min": 0, "max": 255, "required": false, "note": "INFORMATION: the same region of the viewer's own picture file." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.A_viewer_ground_g", "min": 0, "max": 255, "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.A_viewer_ground_b", "min": 0, "max": 255, "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.A_screen_ground_r", "min": 0, "max": 255, "required": false, "note": "INFORMATION: the same region of the screen read in the same frame." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.A_screen_ground_g", "min": 0, "max": 255, "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.A_screen_ground_b", "min": 0, "max": 255, "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.A_capture_diff_max", "min": 0, "max": 255, "required": false, "note": "INFORMATION: the largest channel difference between the viewer's picture and the screen read. Over 4: the capture path differs." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.A_vs_B_diff_max", "min": 0, "max": 255, "required": false, "note": "INFORMATION: the largest channel difference between A's screen read (vessel held at 300 m) and B's (vessel on the pad). Over 4: the placement changes what the game draws." },

    { "series": "K-S2", "section": "SURFACEGROUND", "start": "capture_ab", "metric": "GRD.scene_path_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the flight was reached through the space centre (the series' viaSpaceCentre): the log says 'scene path: space centre'." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "ground_on", "metric": "GRD.scene_path_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the flight was reached through the space centre, as a player's is: the log says 'scene path: space centre'. Straight from the main menu the KSC ground is a different (grey-blue) one." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "ground_off", "metric": "GRD.scene_path_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: as ground_on." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "ground_nocover", "metric": "GRD.scene_path_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: as ground_on." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "ground_on", "metric": "GRD.ground_green_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: the green share of the far_p2 picture (mean G - (R + B) / 2 over the lower left, x 0-33 %, bottom 15 %) is at least 9: through the space centre it reads about +15, straight from the main menu about +4 (pictures of 2026-11-16). Fails: the ground of the series is not the one a player sees." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "ground_off", "metric": "GRD.ground_green_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: as ground_on." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "ground_nocover", "metric": "GRD.ground_green_ok", "equals": 1, "tolerance": 0, "note": "EXPECTED: as ground_on." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "ground_on", "metric": "GRD.green_share", "min": -50, "max": 100, "required": false, "note": "INFORMATION: the green share of the far_p2 picture (G - (R + B) / 2 in the lower-left box; tools/vanilla_ground.py's low_green is the same measure over the lowest quarter)." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "ground_on", "metric": "GRD.far_p1_green_share", "min": -50, "max": 100, "required": false, "note": "INFORMATION: the green share of each frame's picture." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "ground_on", "metric": "GRD.far_p2_green_share", "min": -50, "max": 100, "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "ground_on", "metric": "GRD.g2_p1_green_share", "min": -50, "max": 100, "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "ground_on", "metric": "GRD.g2_p2_green_share", "min": -50, "max": 100, "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "ground_off", "metric": "GRD.green_share", "min": -50, "max": 100, "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "ground_off", "metric": "GRD.far_p1_green_share", "min": -50, "max": 100, "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "ground_off", "metric": "GRD.far_p2_green_share", "min": -50, "max": 100, "required": false, "note": "INFORMATION." },
    { "series": "K-S2", "section": "SURFACEGROUND", "start": "ground_off", "metric": "GRD.g2_p1_green_share", "min": -50, "max": 100, "required": false, "note": "INFORMATION." },
