<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- KSP 1.12.5 runs on Mono with a .NET 4.x profile; newer language
         features need runtime support this Mono does not have. -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>$(ModName)</AssemblyName>
    <RootNamespace>ReDefinition</RootNamespace>
    <OutputPath>$(MSBuildThisFileDirectory)..\build\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <Version>0.1.3</Version>
    <Product>ReDefinition</Product>
    <Copyright>Copyright (C) 2026 CaptainKeyboard. GPL-3.0</Copyright>
    <!-- FSR3Unity gates its debug view behind UNITY_EDITOR or DEVELOPMENT_BUILD,
         and Unity defines neither in a plain plugin build. Development builds
         define it: FSR's debug view pass, its switch in the diagnostics window,
         and FSR's own EnableDebugChecking. The player package
         (-p:ReleasePackage=true) is built without it. -->
    <DefineConstants Condition="'$(ReleasePackage)' != 'true'">$(DefineConstants);DEVELOPMENT_BUILD</DefineConstants>

    <!-- ReDefinition.xml beside the DLL: the interface for mods (src/Api) documented for the
         IDE of a mod that references ReDefinition.dll. Only src/Api carries XML
         documentation, so a public member without it (CS1591) is not reported; malformed
         documentation is. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Building this project deploys into the game's GameData (target DeployToGameData). Set to false when a build should not.
         The test project pins false on its reference to this project, so a test run never deploys. -->
    <DeployToGameData Condition="'$(DeployToGameData)' == ''">true</DeployToGameData>
  </PropertyGroup>

  <!-- The decisions of the store and the settings window are tested without the
       game (tests/ReDefinition.Tests). -->
  <!-- PlannerProbes: whether this build references the planner. The developer probes (src/Probe) test planner features through
       its internals; they are compiled in only with the define REDEFINITION_PLANNER_PROBES, which this property sets. It is
       true by default and false in the player package (-p:ReleasePackage=true), whose ReDefinition.dll must not name
       ReDefinition.Planner at all (tools/checks/check_no_reference.ps1). Pass -p:PlannerProbes=false to build that way
       in Debug. In both cases the planner is built before and its DLL lands in the output beside this one (it ships in the
       package and goes to the game), but with false nothing is referenced. -->
  <PropertyGroup>
    <PlannerProbes Condition="'$(PlannerProbes)' == '' And '$(ReleasePackage)' != 'true'">true</PlannerProbes>
    <PlannerProbes Condition="'$(PlannerProbes)' == ''">false</PlannerProbes>
    <DefineConstants Condition="'$(PlannerProbes)' == 'true'">$(DefineConstants);REDEFINITION_PLANNER_PROBES</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Common\**;Planner\**;Dashboard\**;Atmospheres\**" />
    <ProjectReference Include="Common\ReDefinition.Common.csproj" />
    <!-- The dashboard is built before this project, so that its DLL lands in the output beside this one (it ships in the package
         and goes to the game), but nothing of it is referenced (tools/checks/check_no_reference.ps1). -->
    <ProjectReference Include="Dashboard\ReDefinition.Dashboard.csproj" ReferenceOutputAssembly="false" />
    <!-- The atmospheres, the same way (tools/checks/check_no_reference.ps1). -->
    <ProjectReference Include="Atmospheres\ReDefinition.Atmospheres.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="Planner\ReDefinition.Planner.csproj" Condition="'$(PlannerProbes)' == 'true'" />
    <ProjectReference Include="Planner\ReDefinition.Planner.csproj" Condition="'$(PlannerProbes)' != 'true'"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReDefinition.Tests" />
  </ItemGroup>

  <!-- Replaces the .NET Framework developer pack: the reference assemblies come
       as a NuGet package so that nothing beyond the .NET SDK has to be installed. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Private=false: game DLLs must never be copied into GameData, otherwise KSP
       loads half of the Unity modules a second time. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KspManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(KspManaged)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(KspManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KspManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- For the precompiled compute shaders: they ship as an AssetBundle because
         a Unity player cannot compile shaders at runtime. -->
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(KspManaged)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- KSP's ApplicationLauncher names Animator in its signature. -->
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(KspManaged)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The reactive mask draws particle systems, whose renderer lives here. -->
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(KspManaged)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- KSP's master volume is Unity's AudioListener, which lives here. -->
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(KspManaged)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The main menu entry widens its BoxCollider, which lives here. -->
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(KspManaged)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(KspManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(KspManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(KspManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.SharedInternalsModule">
      <HintPath>$(KspManaged)\UnityEngine.SharedInternalsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- uGUI: ScrollRect and ContentSizeFitter, for the scroll list of the
         settings window (src/Ui/TabScrollList.cs). -->
    <Reference Include="UnityEngine.UI">
      <HintPath>$(KspManaged)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Canvas and RectTransformUtility: whether the cursor is over one of this
         mod's windows (src/Ui/UnityMouseEvents.cs). -->
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(KspManaged)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The scene probe's capture of the finished frame (src/Probe/SceneProbe.cs). -->
    <Reference Include="UnityEngine.ScreenCaptureModule">
      <HintPath>$(KspManaged)\UnityEngine.ScreenCaptureModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The parity probe's picture as a PNG (src/Raytracing/RtCamera.Probe.cs, ParityRead). -->
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(KspManaged)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The player's download of NVIDIA's DLLs from NVIDIA's release
         (src/Vendor/NvidiaDownloader.cs). -->
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(KspManaged)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- A requirement (src/KspAssemblyInfo.cs): the section in KSP's own
         settings dialog, the close buttons on the bundled mods' windows, and the
         hooks on Scatterer's godrays, EVE's clouds, TUFX's post-processing and
         TUFX's and Distant Object's own windows. The shared copy in 000_Harmony. -->
    <Reference Include="0Harmony">
      <HintPath>$(KspGameData)\000_Harmony\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Before references are resolved, so a missing game or Harmony stops the
       build with this message instead of a page of unresolved-type errors. -->
  <Target Name="StopIfKspMissing" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(KspManaged)')">
    <Error Text="KSP not found at '$(KspRoot)'. Adjust the path in Directory.Build.props." />
  </Target>

  <Target Name="StopIfHarmonyMissing" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(KspGameData)\000_Harmony\0Harmony.dll')">
    <Error Text="Harmony not found at '$(KspGameData)\000_Harmony\0Harmony.dll'. ReDefinition requires it, to build and to play (install HarmonyKSP): KSP does not load the mod without it." />
  </Target>

  <Target Name="StopIfPackageNotRelease" BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(ReleasePackage)' == 'true' And '$(Configuration)' != 'Release'">
    <Error Text="-p:ReleasePackage=true builds the player package and needs -c Release; otherwise it would only put a DLL without FSR's debug checks into the game." />
  </Target>

  <!-- The repository's git hooks (.githooks): every commit says what it changed in the connectors (tools/hooks). Git runs
       hooks only from the folder core.hooksPath names, so the build sets it; where this is not a git checkout nothing is done. -->
  <Target Name="InstallGitHooks" BeforeTargets="BeforeBuild" Condition="Exists('$(MSBuildThisFileDirectory)..\.git')">
    <Exec Command="git config core.hooksPath .githooks" WorkingDirectory="$(MSBuildThisFileDirectory).." IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low" />
  </Target>

  <!-- The KSP-AVC version file, generated from the project's version, as
       KSPCommunityFixes generates its own (KSPBuildTools). Built and tested
       against KSP 1.12.5; 1.12.0 and up run the same interfaces of KSP that
       this uses, so the range is the one the other mods of this kind give
       (EVE, Kopernicus: 1.12.0 to 1.12.99).
       URL is the copy on the repository's main branch, which KSP-AVC compares
       with the installed one: the build writes it into the repository root as
       well, and the release package refuses a working tree that differs from
       HEAD, so a version is released only with its copy committed. -->
  <Target Name="GenerateVersionFile" AfterTargets="Build">
    <PropertyGroup>
      <_AvcDir>$(OutputPath)GameData\$(ModName)\Main</_AvcDir>
      <_AvcHome>https://github.com/CaptainKeyboard/$(ModName)</_AvcHome>
      <_AvcRaw>https://raw.githubusercontent.com/CaptainKeyboard/$(ModName)/main</_AvcRaw>
    </PropertyGroup>
    <ItemGroup>
      <_AvcLine Include="{" />
      <_AvcLine Include="&quot;NAME&quot;: &quot;$(ModName)&quot;," />
      <_AvcLine Include="&quot;URL&quot;: &quot;$(_AvcRaw)/$(ModName).version&quot;," />
      <_AvcLine Include="&quot;DOWNLOAD&quot;: &quot;$(_AvcHome)/releases/latest&quot;," />
      <_AvcLine Include="&quot;CHANGE_LOG_URL&quot;: &quot;$(_AvcRaw)/CHANGELOG.md&quot;," />
      <_AvcLine Include="&quot;VERSION&quot;: &quot;$(Version)&quot;," />
      <_AvcLine Include="&quot;KSP_VERSION&quot;: &quot;1.12.5&quot;," />
      <_AvcLine Include="&quot;KSP_VERSION_MIN&quot;: &quot;1.12.0&quot;," />
      <_AvcLine Include="&quot;KSP_VERSION_MAX&quot;: &quot;1.12.99&quot;" />
      <_AvcLine Include="}" />
    </ItemGroup>
    <MakeDir Directories="$(_AvcDir)" />
    <WriteLinesToFile File="$(_AvcDir)\$(ModName).version" Lines="@(_AvcLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(MSBuildThisFileDirectory)..\$(ModName).version" Lines="@(_AvcLine)" Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <!-- ReDefinition Planner's own, with its own version. -->
    <ItemGroup>
      <_PlannerAvcLine Include="{" />
      <_PlannerAvcLine Include="&quot;NAME&quot;: &quot;$(PlannerName)&quot;," />
      <_PlannerAvcLine Include="&quot;URL&quot;: &quot;$(_AvcRaw)/$(PlannerName).version&quot;," />
      <_PlannerAvcLine Include="&quot;DOWNLOAD&quot;: &quot;$(_AvcHome)/releases/latest&quot;," />
      <_PlannerAvcLine Include="&quot;CHANGE_LOG_URL&quot;: &quot;$(_AvcRaw)/CHANGELOG.md&quot;," />
      <_PlannerAvcLine Include="&quot;VERSION&quot;: &quot;$(PlannerVersion)&quot;," />
      <_PlannerAvcLine Include="&quot;KSP_VERSION&quot;: &quot;1.12.5&quot;," />
      <_PlannerAvcLine Include="&quot;KSP_VERSION_MIN&quot;: &quot;1.12.0&quot;," />
      <_PlannerAvcLine Include="&quot;KSP_VERSION_MAX&quot;: &quot;1.12.99&quot;" />
      <_PlannerAvcLine Include="}" />
    </ItemGroup>
    <MakeDir Directories="$(OutputPath)GameData\$(ModName)\Planner" />
    <WriteLinesToFile File="$(OutputPath)GameData\$(ModName)\Planner\$(PlannerName).version" Lines="@(_PlannerAvcLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(MSBuildThisFileDirectory)..\$(PlannerName).version" Lines="@(_PlannerAvcLine)" Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <!-- ReDefinition Dashboard's own, with its own version. -->
    <ItemGroup>
      <_DashboardAvcLine Include="{" />
      <_DashboardAvcLine Include="&quot;NAME&quot;: &quot;$(DashboardName)&quot;," />
      <_DashboardAvcLine Include="&quot;URL&quot;: &quot;$(_AvcRaw)/$(DashboardName).version&quot;," />
      <_DashboardAvcLine Include="&quot;DOWNLOAD&quot;: &quot;$(_AvcHome)/releases/latest&quot;," />
      <_DashboardAvcLine Include="&quot;CHANGE_LOG_URL&quot;: &quot;$(_AvcRaw)/CHANGELOG.md&quot;," />
      <_DashboardAvcLine Include="&quot;VERSION&quot;: &quot;$(DashboardVersion)&quot;," />
      <_DashboardAvcLine Include="&quot;KSP_VERSION&quot;: &quot;1.12.5&quot;," />
      <_DashboardAvcLine Include="&quot;KSP_VERSION_MIN&quot;: &quot;1.12.0&quot;," />
      <_DashboardAvcLine Include="&quot;KSP_VERSION_MAX&quot;: &quot;1.12.99&quot;" />
      <_DashboardAvcLine Include="}" />
    </ItemGroup>
    <MakeDir Directories="$(OutputPath)GameData\$(ModName)\Dashboard" />
    <WriteLinesToFile File="$(OutputPath)GameData\$(ModName)\Dashboard\$(DashboardName).version" Lines="@(_DashboardAvcLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(MSBuildThisFileDirectory)..\$(DashboardName).version" Lines="@(_DashboardAvcLine)" Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <!-- ReDefinition Atmospheres' own, with its own version. -->
    <ItemGroup>
      <_AtmospheresAvcLine Include="{" />
      <_AtmospheresAvcLine Include="&quot;NAME&quot;: &quot;$(AtmospheresName)&quot;," />
      <_AtmospheresAvcLine Include="&quot;URL&quot;: &quot;$(_AvcRaw)/$(AtmospheresName).version&quot;," />
      <_AtmospheresAvcLine Include="&quot;DOWNLOAD&quot;: &quot;$(_AvcHome)/releases/latest&quot;," />
      <_AtmospheresAvcLine Include="&quot;CHANGE_LOG_URL&quot;: &quot;$(_AvcRaw)/CHANGELOG.md&quot;," />
      <_AtmospheresAvcLine Include="&quot;VERSION&quot;: &quot;$(AtmospheresVersion)&quot;," />
      <_AtmospheresAvcLine Include="&quot;KSP_VERSION&quot;: &quot;1.12.5&quot;," />
      <_AtmospheresAvcLine Include="&quot;KSP_VERSION_MIN&quot;: &quot;1.12.0&quot;," />
      <_AtmospheresAvcLine Include="&quot;KSP_VERSION_MAX&quot;: &quot;1.12.99&quot;," />
      <_AtmospheresAvcLine Include="&quot;DEPENDS&quot;: [&quot;$(ModName)&quot;, &quot;$(CommonName)&quot;]" />
      <_AtmospheresAvcLine Include="}" />
    </ItemGroup>
    <MakeDir Directories="$(OutputPath)GameData\$(ModName)\Atmospheres" />
    <WriteLinesToFile File="$(OutputPath)GameData\$(ModName)\Atmospheres\$(AtmospheresName).version" Lines="@(_AtmospheresAvcLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(MSBuildThisFileDirectory)..\$(AtmospheresName).version" Lines="@(_AtmospheresAvcLine)" Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <!-- The common DLL's own, with the version of the code in src/Common: all packages carry the one copy in Common/. -->
    <ItemGroup>
      <_CommonAvcLine Include="{" />
      <_CommonAvcLine Include="&quot;NAME&quot;: &quot;$(CommonName)&quot;," />
      <_CommonAvcLine Include="&quot;URL&quot;: &quot;$(_AvcRaw)/$(CommonName).version&quot;," />
      <_CommonAvcLine Include="&quot;DOWNLOAD&quot;: &quot;$(_AvcHome)/releases/latest&quot;," />
      <_CommonAvcLine Include="&quot;CHANGE_LOG_URL&quot;: &quot;$(_AvcRaw)/CHANGELOG.md&quot;," />
      <_CommonAvcLine Include="&quot;VERSION&quot;: &quot;$(CommonVersion)&quot;," />
      <_CommonAvcLine Include="&quot;KSP_VERSION&quot;: &quot;1.12.5&quot;," />
      <_CommonAvcLine Include="&quot;KSP_VERSION_MIN&quot;: &quot;1.12.0&quot;," />
      <_CommonAvcLine Include="&quot;KSP_VERSION_MAX&quot;: &quot;1.12.99&quot;" />
      <_CommonAvcLine Include="}" />
    </ItemGroup>
    <MakeDir Directories="$(OutputPath)GameData\$(ModName)\Common" />
    <WriteLinesToFile File="$(OutputPath)GameData\$(ModName)\Common\$(CommonName).version" Lines="@(_CommonAvcLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(MSBuildThisFileDirectory)..\$(CommonName).version" Lines="@(_CommonAvcLine)" Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- The iCUE widget for Corsair's touch screens: the dashboard's folder as a zip whose files are
       stored, not compressed, as Corsair's icuewidget-cli writes it (tools/icuewidget validates it).
       Made with every build, so that the deploy and the release zip carry it beside the mod's
       folder's other files; MSBuild's own ZipDirectory compresses always. -->
  <UsingTask TaskName="ZipStored" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceDirectory ParameterType="System.String" Required="true" />
      <DestinationFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string root = Path.GetFullPath(SourceDirectory).TrimEnd('\\', '/') + Path.DirectorySeparatorChar;
        string[] files = Directory.GetFiles(root, "*", SearchOption.AllDirectories);
        Array.Sort(files, StringComparer.Ordinal);
        Directory.CreateDirectory(Path.GetDirectoryName(Path.GetFullPath(DestinationFile)));
        using (FileStream stream = File.Create(DestinationFile))
        using (ZipArchive zip = new ZipArchive(stream, ZipArchiveMode.Create))
        {
            foreach (string file in files)
            {
                string name = file.Substring(root.Length).Replace('\\', '/');
                // As the CLI: no hidden files, no package inside the package.
                if (name.StartsWith(".") || name.Contains("/.") || name.EndsWith(".icuewidget")) continue;
                ZipArchiveEntry entry = zip.CreateEntry(name, CompressionLevel.NoCompression);
                using (Stream to = entry.Open())
                using (FileStream from = File.OpenRead(file))
                    from.CopyTo(to);
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <ItemGroup>
    <_IcueWidgetSource Include="$(MSBuildThisFileDirectory)..\GameData\$(ModName)\Dashboard\**\*" />
  </ItemGroup>

  <Target Name="PackageIcueWidget" AfterTargets="Build" Inputs="@(_IcueWidgetSource)" Outputs="$(OutputPath)ksp-dashboard.icuewidget">
    <ZipStored SourceDirectory="$(MSBuildThisFileDirectory)..\GameData\$(ModName)\Dashboard" DestinationFile="$(OutputPath)ksp-dashboard.icuewidget" />
  </Target>

  <Target Name="DeployToGameData" AfterTargets="Build" DependsOnTargets="GenerateVersionFile;PackageIcueWidget"
          Condition="'$(DeployToGameData)' == 'true' And Exists('$(KspGameData)')">
    <PropertyGroup>
      <_Game>$(KspGameData)\$(ModName)</_Game>
    </PropertyGroup>
    <!-- The game's folder holds one shared folder, GameData/ReDefinition, with Main, Common, Planner, Dashboard and Atmospheres in it.
         What an earlier layout left is moved or removed first: the shader bundle (costly to rebuild) and the
         settings (PluginData) of the old places move into the new ones, unless those exist; the old planner
         folder, and the files of the old top level that KSP would read a second time (textures, configs, DLLs),
         are deleted, and so is the dashboard's web folder under Main, now a folder of its own. Main, Common, Planner, Dashboard and Atmospheres
         themselves are never deleted. -->
    <ItemGroup>
      <_OldShaders Include="$(_Game)\Shaders\**\*" />
      <_OldPluginData Include="$(_Game)\PluginData\**\*" />
      <_OldPlannerData Include="$(KspGameData)\$(PlannerName)\PluginData\**\*" />
      <_OldIni Include="$(_Game)\ReDefinitionProxy.ini" />
    </ItemGroup>
    <Move Condition="!Exists('$(_Game)\Main\Shaders')" SourceFiles="@(_OldShaders)" DestinationFiles="@(_OldShaders->'$(_Game)\Main\Shaders\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Move Condition="!Exists('$(_Game)\Main\PluginData')" SourceFiles="@(_OldPluginData)" DestinationFiles="@(_OldPluginData->'$(_Game)\Main\PluginData\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Move Condition="!Exists('$(_Game)\Planner\PluginData')" SourceFiles="@(_OldPlannerData)" DestinationFiles="@(_OldPlannerData->'$(_Game)\Planner\PluginData\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Move Condition="!Exists('$(_Game)\Main\ReDefinitionProxy.ini')" SourceFiles="@(_OldIni)" DestinationFiles="$(_Game)\Main\ReDefinitionProxy.ini" />
    <ItemGroup>
      <_OldTopFiles Include="$(_Game)\README.md;$(_Game)\CHANGELOG.md;$(_Game)\CREDITS.md;$(_Game)\ReDefinition.version;$(_Game)\ksp-dashboard.icuewidget;$(_Game)\ReDefinitionProxy.ini" />
      <_OldTopFiles Include="$(_Game)\Main\ksp-dashboard.icuewidget" />
      <_OldTopFiles Include="$(_Game)\LICENSE*;$(_Game)\EXCEPTIONS.md;$(_Game)\SOURCE.md" />
    </ItemGroup>
    <Delete Files="@(_OldTopFiles)" />
    <!-- Shaders and PluginData are removed only where the new place exists: what is left of an old one is then stale. -->
    <RemoveDir Directories="$(_Game)\Plugins;$(_Game)\Profiles;$(_Game)\Mods;$(_Game)\Patches;$(_Game)\Icons;$(_Game)\Main\Dashboard;$(KspGameData)\$(PlannerName);$(_Game)\Seasons" />
    <!-- $(_Game)\Seasons is the folder of the product before it was renamed to Atmospheres: its plugins, the Common copy, the cloud config, the shader bundle and the old PluginData. -->
    <Delete Files="$(_Game)\Main\Plugins\ReDefinition.Seasons.dll" />
    <RemoveDir Condition="Exists('$(_Game)\Main\Shaders')" Directories="$(_Game)\Shaders" />
    <RemoveDir Condition="Exists('$(_Game)\Main\PluginData')" Directories="$(_Game)\PluginData" />
    <MakeDir Directories="$(_Game)\Main\Plugins;$(_Game)\Common\Plugins;$(_Game)\Planner\Plugins;$(_Game)\Dashboard\Plugins;$(_Game)\Atmospheres\Plugins" />
    <!-- One copy of the common DLL, in its own folder: a second copy of the same assembly version would be kept as often as the new one. -->
    <Delete Files="$(_Game)\Main\Plugins\ReDefinition.Common.dll;$(_Game)\Main\Plugins\ReDefinition.Planner.dll;$(_Game)\Planner\Plugins\ReDefinition.Common.dll" />
    <Delete Files="$(_Game)\Main\Plugins\ReDefinition.Dashboard.dll;$(_Game)\Dashboard\Plugins\ReDefinition.Common.dll" />
    <Delete Files="$(_Game)\Main\Plugins\ReDefinition.Atmospheres.dll;$(_Game)\Atmospheres\Plugins\ReDefinition.Common.dll" />
    <Copy SourceFiles="$(OutputPath)$(ModName).dll;$(OutputPath)$(ModName).xml" DestinationFolder="$(_Game)\Main\Plugins" />
    <Copy SourceFiles="$(OutputPath)ReDefinition.Common.dll" DestinationFolder="$(_Game)\Common\Plugins" />
    <Copy SourceFiles="$(OutputPath)ReDefinition.Planner.dll" DestinationFolder="$(_Game)\Planner\Plugins" />
    <Copy SourceFiles="$(OutputPath)ReDefinition.Dashboard.dll" DestinationFolder="$(_Game)\Dashboard\Plugins" />
    <Copy SourceFiles="$(OutputPath)ReDefinition.Atmospheres.dll" DestinationFolder="$(_Game)\Atmospheres\Plugins" />
    <Copy SourceFiles="$(OutputPath)GameData\$(ModName)\Main\$(ModName).version" DestinationFolder="$(_Game)\Main" />
    <Copy SourceFiles="$(OutputPath)GameData\$(ModName)\Planner\$(PlannerName).version" DestinationFolder="$(_Game)\Planner" />
    <Copy SourceFiles="$(OutputPath)GameData\$(ModName)\Dashboard\$(DashboardName).version;$(OutputPath)ksp-dashboard.icuewidget" DestinationFolder="$(_Game)\Dashboard" />
    <Copy SourceFiles="$(OutputPath)GameData\$(ModName)\Atmospheres\$(AtmospheresName).version" DestinationFolder="$(_Game)\Atmospheres" />
    <Copy SourceFiles="$(OutputPath)GameData\$(ModName)\Common\$(CommonName).version" DestinationFolder="$(_Game)\Common" />
<!-- The static GameData files of the repository (profiles and mod
         registrations), copied the way KSPCommunityFixes copies its own. What
         this build ships is removed from the game first, so that a file dropped
         from the repository leaves the game: the profiles with the prefix
         ReDefinition- (one a player put there by hand stays) and the
         registrations in Mods, which other mods ship in folders of their own, and
         the ModuleManager patches in Patches.
         PluginData is never touched. -->
    <ItemGroup>
      <_StaticGameData Include="$(MSBuildThisFileDirectory)..\GameData\**\*.*" />
      <_ShippedInGame Include="$(KspGameData)\$(ModName)\Main\Profiles\ReDefinition-*.cfg" />
      <_ShippedInGame Include="$(KspGameData)\$(ModName)\Main\Mods\*.cfg" />
      <_ShippedInGame Include="$(KspGameData)\$(ModName)\Main\Patches\*.cfg" />
    </ItemGroup>
    <Delete Files="@(_ShippedInGame)" />
    <Copy SourceFiles="@(_StaticGameData)" DestinationFolder="$(KspGameData)\%(RecursiveDir)" />
    <Message Importance="high" Text="$(ModName).dll, $(ModName).version, and the static GameData files copied to $(KspGameData)\$(ModName)\Main, the planner to ...\Planner, the dashboard with the iCUE widget to ...\Dashboard, the atmospheres to ...\Atmospheres, the common DLL to ...\Common." />
  </Target>

  <!-- The player package, built only on request:
         dotnet build -c Release -p:ReleasePackage=true
       the way KSPCommunityFixes builds its release zip: GameData with the
       mod's folder inside. In it, as the forum's add-on rules and the licences
       ask: this project's licence and exceptions, the MIT notices of FSR3Unity
       and of AMD's FidelityFX shaders compiled into the bundle, Unity's
       built-in shader source in it, those of
       Telemachus (whose API the dashboard follows) and Project Nayuki's QR Code
       generator (translated into src/Dashboard/QrCode.cs), the credits,
       and a note on the source. Next to it, the complete source of the commit
       it was built from, as GPL-3.0 section 6(d) asks - so the tree has to be
       committed first. The shader bundle is built by the Unity project into
       the game's GameData, so it is taken from there, and only if no shader
       source is newer than it. Whenever any of that fails there is no zip, and
       one left from an earlier build is removed so it cannot pass for this
       one. Next to GameData go the files for the game folder: the proxy,
       refused when missing or older than a native source, with the MIT notices
       of NVIDIA's, AMD's and Intel's headers compiled into it, and AMD's runtime,
       fetched by tools/fetch_amd_runtime.py and refused unless it matches the
       pinned SHA-256, with AMD's licence beside it. The
       proxy's ini goes into GameData as a template only: without it the
       proxy's defaults apply, and one in the game folder holds a player's
       settings, which an update must not overwrite (docs/development/packaging.md). -->
  <Target Name="MakeReleaseZip" AfterTargets="DeployToGameData" DependsOnTargets="GenerateVersionFile;PackageIcueWidget"
          Condition="'$(Configuration)' == 'Release' And '$(ReleasePackage)' == 'true'">
    <PropertyGroup>
      <_ReleaseDir>$(OutputPath)release</_ReleaseDir>
      <_Stage>$(_ReleaseDir)\stage</_Stage>
      <_StageMod>$(_Stage)\GameData\$(ModName)\Main</_StageMod>
      <_StagePlanner>$(_Stage)\GameData\$(ModName)\Planner</_StagePlanner>
      <_StageDashboard>$(_Stage)\GameData\$(ModName)\Dashboard</_StageDashboard>
      <_StageAtmospheres>$(_Stage)\GameData\$(ModName)\Atmospheres</_StageAtmospheres>
      <_StageCommon>$(_Stage)\GameData\$(ModName)\Common</_StageCommon>
      <_PlannerOnly>$(_ReleaseDir)\planner-stage</_PlannerOnly>
      <_PlannerZip>$(_ReleaseDir)\$(PlannerName)_$(PlannerVersion).zip</_PlannerZip>
      <_DashboardOnly>$(_ReleaseDir)\dashboard-stage</_DashboardOnly>
      <_DashboardZip>$(_ReleaseDir)\$(DashboardName)_$(DashboardVersion).zip</_DashboardZip>
      <_AtmospheresOnly>$(_ReleaseDir)\atmospheres-stage</_AtmospheresOnly>
      <_AtmospheresZip>$(_ReleaseDir)\$(AtmospheresName)_$(AtmospheresVersion).zip</_AtmospheresZip>
      <_CommonOnly>$(_ReleaseDir)\common-stage</_CommonOnly>
      <_CommonZip>$(_ReleaseDir)\$(CommonName)_$(CommonVersion).zip</_CommonZip>
      <_ReleaseZip>$(_ReleaseDir)\$(ModName)_$(Version).zip</_ReleaseZip>
      <_SourceZip>$(_ReleaseDir)\$(ModName)_$(Version)_source.zip</_SourceZip>
      <_ShaderBundle>$(KspGameData)\$(ModName)\Main\Shaders\redefinition.shaders</_ShaderBundle>
      <_AtmospheresBundle>$(KspGameData)\$(ModName)\Atmospheres\Shaders\atmospheres.shaders</_AtmospheresBundle>
      <_RepoRoot>$(MSBuildThisFileDirectory)..\</_RepoRoot>
      <_Native>$(_RepoRoot)src\DxgiProxy</_Native>
      <_ProxyDll>$(_RepoRoot)build\DxgiProxy\Release\dxgi.dll</_ProxyDll>
      <_FfxRuntime>$(_RepoRoot)third_party\amd\amd_fidelityfx_framegeneration_dx12.dll</_FfxRuntime>
      <_FfxRuntimePin>$(_RepoRoot)third_party\amd\amd_fidelityfx_framegeneration_dx12.dll.sha256</_FfxRuntimePin>
      <_FfxDenoiser>$(_RepoRoot)third_party\amd\amd_fidelityfx_denoiser_dx12.dll</_FfxDenoiser>
      <_FfxDenoiserPin>$(_RepoRoot)third_party\amd\amd_fidelityfx_denoiser_dx12.dll.sha256</_FfxDenoiserPin>
    </PropertyGroup>
    <ItemGroup>
      <_ShaderSource Include="$(_RepoRoot)unity\Assets\ReDefinition\Shaders\**\*.compute;$(_RepoRoot)unity\Assets\ReDefinition\Shaders\**\*.h;$(_RepoRoot)unity\Assets\ReDefinition\Shaders\**\*.hlsl;$(_RepoRoot)unity\Assets\ReDefinition\Shaders\**\*.cginc;$(_RepoRoot)unity\Assets\ReDefinition\Shaders\**\*.shader;$(_RepoRoot)unity\Assets\ReDefinition\Include\**\*.cginc;$(_RepoRoot)unity\Assets\ReDefinition\Editor\**\*.cs" />
      <_AtmospheresShaderSource Include="$(_RepoRoot)unity\Assets\ReDefinitionAtmospheres\Shaders\**\*.shader;$(_RepoRoot)unity\Assets\ReDefinitionAtmospheres\Shaders\**\*.cginc;$(_RepoRoot)unity\Assets\ReDefinitionAtmospheres\Editor\**\*.cs" />
      <_StaticGameDataZip Include="$(_RepoRoot)GameData\**\*.*" />
      <_NativeSource Include="$(_Native)\**\*.cpp;$(_Native)\**\*.h;$(_Native)\**\*.hlsl;$(_Native)\**\*.hlsli;$(_Native)\*.def;$(_Native)\*.rc.in;$(_Native)\*.ini;$(_Native)\CMakeLists.txt" />
    </ItemGroup>

    <Delete Files="$(_ReleaseZip);$(_SourceZip)" />
    <RemoveDir Condition="Exists('$(_Stage)')" Directories="$(_Stage)" />

    <Error Condition="!Exists('$(_ProxyDll)')"
           Text="No release zip: the frame generation proxy '$(_ProxyDll)' is missing. Build it first (docs/development/building-and-testing.md)." />
    <Error Condition="$([System.IO.File]::GetLastWriteTime('%(_NativeSource.FullPath)').Ticks) &gt; $([System.IO.File]::GetLastWriteTime('$(_ProxyDll)').Ticks)"
           Text="No release zip: '%(_NativeSource.Identity)' is newer than the proxy. Rebuild it with CMake first." />
    <Error Condition="!Exists('$(_FfxRuntime)')"
           Text="No release zip: AMD's frame generation runtime is missing. Fetch it with: python tools/fetch_amd_runtime.py" />
    <ReadLinesFromFile File="$(_FfxRuntimePin)">
      <Output TaskParameter="Lines" PropertyName="_FfxRuntimePinned" />
    </ReadLinesFromFile>
    <GetFileHash Files="$(_FfxRuntime)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_FfxRuntimeHash" />
    </GetFileHash>
    <Error Condition="'$(_FfxRuntimeHash)' != '$(_FfxRuntimePinned)'"
           Text="No release zip: '$(_FfxRuntime)' does not match the pinned SHA-256 $(_FfxRuntimePinned). Fetch it again with: python tools/fetch_amd_runtime.py" />
    <Error Condition="!Exists('$(_FfxDenoiser)')"
           Text="No release zip: AMD's denoiser runtime is missing. Fetch it with: python tools/fetch_amd_runtime.py" />
    <ReadLinesFromFile File="$(_FfxDenoiserPin)">
      <Output TaskParameter="Lines" PropertyName="_FfxDenoiserPinned" />
    </ReadLinesFromFile>
    <GetFileHash Files="$(_FfxDenoiser)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_FfxDenoiserHash" />
    </GetFileHash>
    <Error Condition="'$(_FfxDenoiserHash)' != '$(_FfxDenoiserPinned)'"
           Text="No release zip: '$(_FfxDenoiser)' does not match the pinned SHA-256 $(_FfxDenoiserPinned). Fetch it again with: python tools/fetch_amd_runtime.py" />
    <Error Condition="!Exists('$(_ShaderBundle)')"
           Text="No release zip: the shader bundle '$(_ShaderBundle)' is missing. Build it with the Unity project first (docs/development/building-and-testing.md)." />
    <Error Condition="$([System.IO.File]::GetLastWriteTime('%(_ShaderSource.FullPath)').Ticks) &gt; $([System.IO.File]::GetLastWriteTime('$(_ShaderBundle)').Ticks)"
           Text="No release zip: '%(_ShaderSource.Identity)' is newer than the shader bundle. Rebuild the bundle with the Unity project first." />
    <Error Condition="!Exists('$(_AtmospheresBundle)')"
           Text="No release zip: the atmospheres' shader bundle '$(_AtmospheresBundle)' is missing. Build it with tools\build_atmospheres_bundle.ps1 first." />
    <Error Condition="$([System.IO.File]::GetLastWriteTime('%(_AtmospheresShaderSource.FullPath)').Ticks) &gt; $([System.IO.File]::GetLastWriteTime('$(_AtmospheresBundle)').Ticks)"
           Text="No release zip: '%(_AtmospheresShaderSource.Identity)' is newer than the atmospheres' shader bundle. Rebuild it with tools\build_atmospheres_bundle.ps1 first." />
    <Exec Command="git --version" WorkingDirectory="$(_RepoRoot)" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_GitMissing" />
    </Exec>
    <Error Condition="'$(_GitMissing)' != '0'" Text="No release zip: git is needed for the source that goes with it, and it was not found." />
    <!-- stderr to the null device: ConsoleToMSBuild captures both streams,
         and a git warning on a clean tree is not a change. Exec runs cmd.exe
         on Windows and sh elsewhere, hence two names for it. -->
    <PropertyGroup>
      <_NullDevice Condition="'$(OS)' == 'Windows_NT'">nul</_NullDevice>
      <_NullDevice Condition="'$(OS)' != 'Windows_NT'">/dev/null</_NullDevice>
    </PropertyGroup>
    <!-- The version against what changed since the last release (tools/checks/check_release_version.ps1). -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_RepoRoot)tools\checks\check_release_version.ps1&quot;" />
    <!-- The player's ReDefinition.dll names nothing of the planner, the dashboard and the atmospheres, and their own DLLs name neither
         ReDefinition, Harmony nor ZTheme (tools/checks/check_no_reference.ps1). -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_RepoRoot)tools\checks\check_no_reference.ps1&quot; -Name Planner,Dashboard,Atmospheres -Dll &quot;$(OutputPath)$(ModName).dll&quot;" />
    <Exec Command="git status --porcelain 2&gt;$(_NullDevice)" WorkingDirectory="$(_RepoRoot)" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_TreeStatus" />
    </Exec>
    <Error Condition="'$(_TreeStatus)' != ''"
           Text="No release zip: the working tree has changes or untracked files, and the source that goes with the package is HEAD's. Commit first." />

    <Copy SourceFiles="$(OutputPath)$(ModName).dll;$(OutputPath)$(ModName).xml" DestinationFolder="$(_StageMod)\Plugins" />
    <!-- Every package carries the one common DLL, in Common/, with its version file, so that they overwrite the same files. -->
    <Copy SourceFiles="$(OutputPath)ReDefinition.Common.dll" DestinationFolder="$(_StageCommon)\Plugins" />
    <Copy SourceFiles="$(OutputPath)GameData\$(ModName)\Common\$(CommonName).version" DestinationFolder="$(_StageCommon)" />
    <!-- The AIO carries the planner too, in the folder the planner's own package uses, so that both packages overwrite the same files. -->
    <Copy SourceFiles="$(OutputPath)ReDefinition.Planner.dll" DestinationFolder="$(_StagePlanner)\Plugins" />
    <Copy SourceFiles="$(OutputPath)GameData\$(ModName)\Planner\$(PlannerName).version;$(_RepoRoot)LICENSE;$(_RepoRoot)EXCEPTIONS.md;$(_RepoRoot)CHANGELOG.md" DestinationFolder="$(_StagePlanner)" />
    <Copy SourceFiles="$(_RepoRoot)src\Planner\README.md" DestinationFolder="$(_StagePlanner)" Condition="Exists('$(_RepoRoot)src\Planner\README.md')" />
    <!-- And the dashboard, in its own folder. Its web files come with the repository's GameData below; the project's
         notices that its pages and its QR code need go with it. -->
    <Copy SourceFiles="$(OutputPath)ReDefinition.Dashboard.dll" DestinationFolder="$(_StageDashboard)\Plugins" />
    <Copy SourceFiles="$(OutputPath)GameData\$(ModName)\Dashboard\$(DashboardName).version;$(OutputPath)ksp-dashboard.icuewidget;$(_RepoRoot)LICENSE;$(_RepoRoot)EXCEPTIONS.md;$(_RepoRoot)CHANGELOG.md" DestinationFolder="$(_StageDashboard)" />
    <Copy SourceFiles="$(_RepoRoot)src\Dashboard\README.md" DestinationFolder="$(_StageDashboard)" Condition="Exists('$(_RepoRoot)src\Dashboard\README.md')" />
    <Copy SourceFiles="$(_RepoRoot)licenses\Telemachus-MIT.txt" DestinationFiles="$(_StageDashboard)\LICENSE-Telemachus.txt" />
    <Copy SourceFiles="$(_RepoRoot)licenses\QR-Code-generator-MIT.txt" DestinationFiles="$(_StageDashboard)\LICENSE-QR-Code-generator.txt" />
    <!-- And the atmospheres, in their own folder. -->
    <Copy SourceFiles="$(OutputPath)ReDefinition.Atmospheres.dll" DestinationFolder="$(_StageAtmospheres)\Plugins" />
    <Copy SourceFiles="$(OutputPath)GameData\$(ModName)\Atmospheres\$(AtmospheresName).version;$(_RepoRoot)LICENSE;$(_RepoRoot)EXCEPTIONS.md;$(_RepoRoot)CHANGELOG.md" DestinationFolder="$(_StageAtmospheres)" />
    <Copy SourceFiles="$(_RepoRoot)src\Atmospheres\README.md" DestinationFolder="$(_StageAtmospheres)" Condition="Exists('$(_RepoRoot)src\Atmospheres\README.md')" />
    <Copy SourceFiles="$(_RepoRoot)licenses\KerbalAlarmClock-MIT.txt" DestinationFiles="$(_StageAtmospheres)\LICENSE-KerbalAlarmClock.txt" />
    <!-- The static files of the atmospheres (the EVE cloud layer's config and its placeholder map) go into the standalone package too. -->
    <ItemGroup>
      <_AtmospheresStatic Include="$(_RepoRoot)GameData\$(ModName)\Atmospheres\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AtmospheresStatic)" DestinationFolder="$(_StageAtmospheres)\%(RecursiveDir)" />
    <Copy SourceFiles="$(_AtmospheresBundle)" DestinationFolder="$(_StageAtmospheres)\Shaders" />
    <Copy SourceFiles="$(_ShaderBundle)" DestinationFolder="$(_StageMod)\Shaders" />
    <Copy SourceFiles="$(OutputPath)GameData\$(ModName)\Main\$(ModName).version;$(_RepoRoot)LICENSE;$(_RepoRoot)EXCEPTIONS.md;$(_RepoRoot)README.md;$(_RepoRoot)CHANGELOG.md;$(_RepoRoot)licenses\SOURCE.md"
          DestinationFolder="$(_StageMod)" />
    <Copy SourceFiles="$(_RepoRoot)docs\credits-and-licences.md" DestinationFiles="$(_StageMod)\CREDITS.md" />
    <Copy SourceFiles="$(_RepoRoot)src\Fsr3\LICENSE.txt" DestinationFiles="$(_StageMod)\LICENSE-FSR3Unity.txt" />
    <Copy SourceFiles="$(_RepoRoot)licenses\FidelityFX-FSR3-MIT.txt" DestinationFiles="$(_StageMod)\LICENSE-FidelityFX.txt" />
    <Copy SourceFiles="$(_RepoRoot)licenses\Bruneton-INRIA-BSD3.txt" DestinationFiles="$(_StageMod)\LICENSE-Bruneton.txt" />
    <Copy SourceFiles="$(_RepoRoot)licenses\Unity-builtin-shaders-MIT.txt" DestinationFiles="$(_StageMod)\LICENSE-Unity-shaders.txt" />
    <Copy SourceFiles="$(_RepoRoot)licenses\Unity-Companion-License.txt" DestinationFiles="$(_StageMod)\LICENSE-Unity-Companion.txt" />
    <Copy SourceFiles="@(_StaticGameDataZip)" DestinationFolder="$(_Stage)\GameData\%(RecursiveDir)" />
    <Copy SourceFiles="$(_ProxyDll);$(_FfxRuntime);$(_FfxDenoiser)" DestinationFolder="$(_Stage)" />
    <Copy SourceFiles="$(_RepoRoot)licenses\AMD-FidelityFX-SDK-license.md" DestinationFiles="$(_Stage)\amd_fidelityfx_framegeneration_dx12_LICENSE.md" />
    <Copy SourceFiles="$(_RepoRoot)licenses\AMD-FidelityFX-SDK-license.md" DestinationFiles="$(_Stage)\amd_fidelityfx_denoiser_dx12_LICENSE.md" />
    <Copy SourceFiles="$(_RepoRoot)licenses\NVIDIA-MIT.txt" DestinationFiles="$(_Stage)\dxgi_LICENSE-NVIDIA.txt" />
    <Copy SourceFiles="$(_RepoRoot)licenses\AMD-FidelityFX-API-MIT.txt" DestinationFiles="$(_Stage)\dxgi_LICENSE-FidelityFX.txt" />
    <Copy SourceFiles="$(_RepoRoot)licenses\AMD-AntiLag2-MIT.txt" DestinationFiles="$(_Stage)\dxgi_LICENSE-AntiLag2.txt" />
    <Copy SourceFiles="$(_RepoRoot)licenses\AMD-Capsaicin-MIT.txt" DestinationFiles="$(_Stage)\dxgi_LICENSE-Capsaicin.txt" />
    <Copy SourceFiles="$(_RepoRoot)licenses\Intel-XeSS-MIT.txt" DestinationFiles="$(_Stage)\dxgi_LICENSE-XeSS.txt" />
    <Copy SourceFiles="$(_Native)\ReDefinitionProxy.ini" DestinationFolder="$(_StageMod)" />

    <!-- The source first: if it cannot be made, there is no player zip either. -->
    <Exec Command="git archive --format=zip -o &quot;$(_SourceZip)&quot; HEAD" WorkingDirectory="$(_RepoRoot)" />
    <ZipDirectory SourceDirectory="$(_Stage)" DestinationFile="$(_ReleaseZip)" Overwrite="true" />
    <!-- ReDefinition Planner alone: what the AIO holds of it and of Common, and nothing of the rest. -->
    <ItemGroup>
      <_PlannerPackageFile Include="$(_StagePlanner)\**\*" />
      <_DashboardPackageFile Include="$(_StageDashboard)\**\*" />
      <_AtmospheresPackageFile Include="$(_StageAtmospheres)\**\*" />
      <_CommonPackageFile Include="$(_StageCommon)\**\*" />
    </ItemGroup>
    <Delete Files="$(_PlannerZip);$(_DashboardZip);$(_AtmospheresZip);$(_CommonZip)" />
    <RemoveDir Condition="Exists('$(_AtmospheresOnly)')" Directories="$(_AtmospheresOnly)" />
    <RemoveDir Condition="Exists('$(_PlannerOnly)')" Directories="$(_PlannerOnly)" />
    <RemoveDir Condition="Exists('$(_DashboardOnly)')" Directories="$(_DashboardOnly)" />
    <RemoveDir Condition="Exists('$(_CommonOnly)')" Directories="$(_CommonOnly)" />
    <Copy SourceFiles="@(_PlannerPackageFile)" DestinationFolder="$(_PlannerOnly)\GameData\$(ModName)\Planner\%(RecursiveDir)" />
    <Copy SourceFiles="@(_CommonPackageFile)" DestinationFolder="$(_PlannerOnly)\GameData\$(ModName)\Common\%(RecursiveDir)" />
    <ZipDirectory SourceDirectory="$(_PlannerOnly)" DestinationFile="$(_PlannerZip)" Overwrite="true" />
    <!-- ReDefinition Dashboard alone, the same way. -->
    <Copy SourceFiles="@(_DashboardPackageFile)" DestinationFolder="$(_DashboardOnly)\GameData\$(ModName)\Dashboard\%(RecursiveDir)" />
    <Copy SourceFiles="@(_CommonPackageFile)" DestinationFolder="$(_DashboardOnly)\GameData\$(ModName)\Common\%(RecursiveDir)" />
    <ZipDirectory SourceDirectory="$(_DashboardOnly)" DestinationFile="$(_DashboardZip)" Overwrite="true" />
    <!-- ReDefinition Atmospheres alone, the same way. -->
    <Copy SourceFiles="@(_AtmospheresPackageFile)" DestinationFolder="$(_AtmospheresOnly)\GameData\$(ModName)\Atmospheres\%(RecursiveDir)" />
    <Copy SourceFiles="@(_CommonPackageFile)" DestinationFolder="$(_AtmospheresOnly)\GameData\$(ModName)\Common\%(RecursiveDir)" />
    <ZipDirectory SourceDirectory="$(_AtmospheresOnly)" DestinationFile="$(_AtmospheresZip)" Overwrite="true" />
    <!-- The common DLL alone, for a mod that needs only it. -->
    <Copy SourceFiles="@(_CommonPackageFile)" DestinationFolder="$(_CommonOnly)\GameData\$(ModName)\Common\%(RecursiveDir)" />
    <ZipDirectory SourceDirectory="$(_CommonOnly)" DestinationFile="$(_CommonZip)" Overwrite="true" />
    <Message Importance="high" Text="Planner zip: $(_PlannerZip)." />
    <Message Importance="high" Text="Dashboard zip: $(_DashboardZip)." />
    <Message Importance="high" Text="Atmospheres zip: $(_AtmospheresZip)." />
    <Message Importance="high" Text="Common zip:$(_CommonZip)." />
    <Message Importance="high" Text="Release zip: $(_ReleaseZip). Its source: $(_SourceZip)." />
  </Target>

</Project>
