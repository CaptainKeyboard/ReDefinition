// The proxy's version resource, shown under the file's Properties > Details. CMake fills
// in the version from src/ReDefinition.csproj.

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @REDEFINITION_VERSION_MAJOR@,@REDEFINITION_VERSION_MINOR@,@REDEFINITION_VERSION_PATCH@,0
PRODUCTVERSION  @REDEFINITION_VERSION_MAJOR@,@REDEFINITION_VERSION_MINOR@,@REDEFINITION_VERSION_PATCH@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "ReDefinition"
            VALUE "FileDescription",  "ReDefinition frame generation and upscaling proxy for Kerbal Space Program"
            VALUE "FileVersion",      "@REDEFINITION_VERSION@"
            VALUE "InternalName",     "ReDefinitionProxy"
            VALUE "LegalCopyright",   "Copyright (C) 2026 CaptainKeyboard. GPL-3.0-or-later"
            VALUE "OriginalFilename", "dxgi.dll"
            VALUE "ProductName",      "ReDefinition"
            VALUE "ProductVersion",   "@REDEFINITION_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
